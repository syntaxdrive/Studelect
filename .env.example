# StudElect Environment Configuration (100% Free-Tier Ready)

# Supabase PostgreSQL (Free 500MB DB)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Supabase Public API (For client-side realtime subscriptions)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Free Email OTP (Resend - 3,000 free emails/month)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="StudElect <elections@yourdomain.com>"

# Free Telegram Bot 2FA (Optional, 100% Free)
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="StudElectBot"

# Cryptographic Secret for Blind Ballot Nonces
BALLOT_SIGNING_SECRET="replace-with-a-random-64-character-hex-secret-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
